rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.active == true;
    }

    function isManager() {
      return isStaff() && staffDoc().data.role in ['owner', 'manager'];
    }

    function isOwner() {
      return isStaff() && staffDoc().data.role == 'owner';
    }

    function bookingPath(ref) {
      return /databases/$(database)/documents/bookings/$(ref);
    }

    function capacityPath(day) {
      return /databases/$(database)/documents/capacity/$(day);
    }

    function validSlot(id) {
      return id in ['0830', '0930', '1030', '1130', '1230', '1330', '1430', '1530'];
    }

    // ── Staff and roster ───────────────────────────────────────────────────
    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isManager();
      allow create: if isOwner()
        || isManager() && request.resource.data.role in ['manager', 'dispatcher'];
      allow update: if isOwner()
        || isManager()
          && resource.data.role != 'owner'
          && request.resource.data.role in ['manager', 'dispatcher'];
      allow delete: if isOwner()
        || isManager() && resource.data.role != 'owner';
    }

    match /workers/{workerId} {
      allow read: if isStaff();
      allow create, delete: if isManager();
      // Dispatchers may record disruptions and leave; managers edit the rest.
      allow update: if isManager()
        || isStaff() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['disruptions', 'unavailableDates']);
    }

    match /workerDays/{id} {
      allow read, write: if isStaff();
    }

    // ── Settings ───────────────────────────────────────────────────────────
    match /settings/public {
      allow read: if true; // service areas only, no personal data
      allow write: if isManager();
    }

    match /settings/operations {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // ── Capacity ───────────────────────────────────────────────────────────
    // Customers may add exactly one to exactly one window counter, only in
    // the same transaction that creates their own new booking for that date
    // and window, and only while the window is open and under its cap.
    function newBooking() {
      return getAfter(bookingPath(request.resource.data.lastRef)).data;
    }

    function linkedToNewBooking(day) {
      let ref = request.resource.data.lastRef;
      return ref is string
        && !exists(bookingPath(ref))
        && existsAfter(bookingPath(ref))
        && newBooking().customerUid == request.auth.uid
        && newBooking().dateKey == day;
    }

    function customerHoldCreate(day) {
      let k = 'held_' + newBooking().slotId;
      return signedIn()
        && linkedToNewBooking(day)
        && request.resource.data.keys().hasOnly([k, 'lastRef'])
        && request.resource.data[k] == 1;
    }

    function customerHoldUpdate(day) {
      let slot = newBooking().slotId;
      let k = 'held_' + slot;
      let caps = resource.data.get('caps', {});
      return signedIn()
        && linkedToNewBooking(day)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([k, 'lastRef'])
        && request.resource.data[k] == resource.data.get(k, 0) + 1
        && resource.data.get('closed', false) != true
        && !(slot in resource.data.get('closedWindows', []))
        && (!(slot in caps) || request.resource.data[k] <= caps[slot]);
    }

    match /capacity/{day} {
      allow read: if true; // closures and counts only, no personal data
      allow create: if isStaff() || customerHoldCreate(day);
      allow update: if isStaff() || customerHoldUpdate(day);
      allow delete: if false;
    }

    // ── Bookings ───────────────────────────────────────────────────────────
    function ownsBooking() {
      return signedIn() && resource.data.customerUid == request.auth.uid;
    }

    // A road leg over 25 km may only be saved by a manager, for the
    // emergency worker, with an emergency-dispatch reason recorded.
    function legOk(leg, d) {
      return leg == null
        || leg.km <= 25
        || isManager()
          && d.get('workerId', null) is string
          && get(/databases/$(database)/documents/workers/$(d.workerId)).data.isEmergency == true
          && d.get('operationsNote', '') is string
          && d.operationsNote.matches('^Emergency dispatch.*');
    }

    function staffUpdateOk() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return d.customerUid == resource.data.customerUid
        && d.ref == resource.data.ref
        && (!changed.hasAny(['legIn', 'returnLeg', 'workerId'])
          || legOk(d.get('legIn', null), d) && legOk(d.get('returnLeg', null), d));
    }

    match /bookings/{bookingId} {
      // Only a customer who verified their phone by OTP can book, and the
      // booker's number must be that verified number.
      allow create: if signedIn()
        && request.auth.token.phone_number == '+91' + request.resource.data.phone
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.ref == bookingId
        && request.resource.data.status == 'requested'
        && request.resource.data.source == 'customer_app'
        && request.resource.data.capacityHeld == true
        && validSlot(request.resource.data.slotId)
        && request.resource.data.date.split('T')[0] == request.resource.data.dateKey
        && request.resource.data.consentAt is string
        && request.resource.data.history.size() == 1
        && !request.resource.data.keys().hasAny([
          'workerId', 'legIn', 'returnLeg', 'plannedArrivalMinute',
          'plannedFinishMinute', 'operationsNote', 'customerNote', 'riskFlag',
          'creditPreserved', 'amountCollected', 'paymentMethod', 'collectedAt',
          'actualKm', 'actualMinutes', 'offeredDate', 'offeredSlotId',
          'customerChangeRequest'])
        && getAfter(capacityPath(request.resource.data.dateKey)).data.lastRef == bookingId;

      // A missing document may be read so a retry can tell "not saved yet"
      // from "already saved"; it reveals nothing about other bookings.
      allow get: if isStaff() || ownsBooking() || signedIn() && resource == null;
      allow list: if isStaff() || ownsBooking();

      allow update: if isStaff() && staffUpdateOk()
        || ownsBooking()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['customerChangeRequest', 'customerChangeRequestedAt', 'updatedAt']);

      allow delete: if false;
    }

    // ── Incidents and audit ────────────────────────────────────────────────
    match /incidents/{id} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }

    match /audit/{id} {
      allow create: if isStaff() && request.resource.data.actor == request.auth.uid;
      allow read: if isManager();
      allow update, delete: if false;
    }
  }
}
